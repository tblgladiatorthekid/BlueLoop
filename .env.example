# Postgres connection string (Supabase, Neon, Railway, or local Postgres all work).
DATABASE_URL="postgresql://user:password@localhost:5432/blueloop"

# Secret used to sign session tokens. Generate a real random value for every
# environment — never reuse this placeholder past local dev.
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-random-32-byte-secret"

# "development" relaxes the session cookie's Secure flag so it works over
# plain http on localhost. Always "production" in deployed environments.
NODE_ENV="development"
